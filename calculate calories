    except ValueError:
        print("Введите число!")
        choice = int(input("\nВведите номер блюда: ")) - 1  
        if 0 <= choice < len(menu):
            print(f"\n{menu[choice]} — {calories[choice]} ккал на 100 г")


def calculate_calories():
 
    kfa = [1.2, 1.375, 1.55, 1.725][user['activity']]
    
    if user['gender'] == 1:
        bmr = (user['weight'] * 10) + (user['height'] * 6.25) - (user['age'] * 5) - 161
    else:
        bmr = (user['weight'] * 10) + (user['height'] * 6.25) - (user['age'] * 5) + 5
    
    daily_calories = bmr * kfa
    print(f"\n{user['name']}, ваша дневная норма калорий: {daily_calories:.0f} ккал")
   
   
def calculate_daily_dishes():
    global calories 
    print("\nЗапись приёма пищи")
    print("\nМеню блюд:")
    for item in menu:
        print(item)
    print("Выберите блюда (вводите номера по одному, для завершения введите 0):")
    
    selected_dishes = []  
    general_calories = 0  
    
    while True:
        try:
            choice = int(input("Номер блюда (0 - завершить): "))
            if choice == 0:
                break  
            
            index = choice - 1  
            
            if 0 <= index < len(menu):
                weight = int(input(f"Введите вес блюда '{menu[index]}' в граммах: "))
                
                dish_calories = calories[index] * (weight / 100)
                
                selected_dishes.append({
                    'index': index,
                    'weight': weight,
                    'calories': dish_calories
                })
                general_calories += dish_calories
                
                print(f"Добавлено: {menu[index]} ({weight} - {dish_calories:.1f} ккал)")
            else:
                print("Неверный номер блюда! Введите номер блюда из списка")
                
        except ValueError:
            print("Пожалуйста, введите число!")
    
    if selected_dishes:
        print("\nВыбранные блюда:")
        for item in selected_dishes:
            index = item['index']
            weight = item['weight']
            calories = item['calories']
            print(f"- {menu[index]} - {weight} - ({calories:.1f} ккал)")
        
        print(f"\nОбщая калорийность: {general_calories:.1f} ккал")
    else:
        print("Вы не выбрали ни одного блюда.")
    
    show_main_menu()


def show_main_menu():
    print("\nВыберите действие:")
    print("1 - Изменить профиль")
    print("2 - Записать приём пищи")
    print("3 - Рассчитать дневную норму калорий")
    print("4 - Посмотреть меню блюд")
    print("5 - Выход")
    
    try:
        choice = int(input("Ваш выбор: "))
        if choice == 1:
            user_registration()
        elif choice == 2:
            calculate_daily_dishes()
        elif choice == 3:
            calculate_calories()
            show_main_menu()
        elif choice == 4:
            menu_calories()
            show_main_menu()
        elif choice == 5:
            print("До свидания!")
        else:
            print("Неверный выбор!")
            show_main_menu()
    except ValueError:
        print("Введите число!")
        show_main_menu()

user_registration()   

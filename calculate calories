def menu_calories():
    print("\nМеню блюд:")
    for item in menu:
        print(item)
    try:
        choice = int(input("\nВведите номер блюда: ")) - 1  
        if 0 <= choice < len(menu):
            print(f"\n{menu[choice]} — {calories[choice]} ккал на 100 г")
        else:
            print("Неверный номер блюда!")
            choice = int(input("\nВведите номер блюда: ")) - 1  
